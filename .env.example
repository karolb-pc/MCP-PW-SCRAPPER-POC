# Credentials for authenticated sources.
# Copy to .env locally and fill values there. Never commit real secrets.
LOGIN=
PASSWORD=

# Optional local LLM CLI overrides.
# Useful when codex/claude are installed outside PATH, for example in ~/.local/bin.
CODEX_CLI_PATH=
CLAUDE_CLI_PATH=

# Optional global artifact locations.
SCRAPER_DISCOVERY_OUTPUT=output/discovery.json
SCRAPER_DISCOVERY_RUNS_DIR=scrapers/discovery
SCRAPER_DIAGNOSTICS_DIR=diagnostics/latest
SCRAPER_SEMI_DISCOVERY_DIAGNOSTICS_DIR=diagnostics/semi-discovery
SCRAPER_BREAK_DIAGNOSTICS_DIR=diagnostics/llm-break-demo
SCRAPER_AUDIT_DIAGNOSTICS_DIR=diagnostics/source-audit
SCRAPER_REPAIR_NOTIFICATIONS_DIR=notifications/source-repair
SCRAPER_NOTIFICATIONS_DIR=notifications/mock-email-outbox
SCRAPER_EXPORT_DIR=data/successful

# Optional defaults for the sample Books scraper.
BOOKS_OUTPUT_PATH=
BOOKS_DIAGNOSTICS_DIR=
BOOKS_EXPORT_DIR=
