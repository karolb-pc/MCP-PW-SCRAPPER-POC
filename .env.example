# Credentials for authenticated sources.
# Copy to .env locally and fill values there. Never commit real secrets.
LOGIN=
PASSWORD=

# Optional local LLM CLI overrides.
# Useful when codex/claude are installed outside PATH, for example in ~/.local/bin.
CODEX_CLI_PATH=
CLAUDE_CLI_PATH=

# Optional global artifact locations.
SCRAPER_DISCOVERY_OUTPUT=output/discovery.json
SCRAPER_DISCOVERY_RUNS_DIR=output/discovery-runs
SCRAPER_DISCOVERY_DIAGNOSTICS_DIR=diagnostics
SCRAPER_DIAGNOSTICS_DIR=diagnostics/latest
SCRAPER_SESSIONS_DIR=sessions
